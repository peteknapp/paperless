# Copy to .env and fill in. .env is not committed.

# Where Paperless keeps documents on the NAS, as mounted on bps27 (no trailing
# slash). Holds media/, consume/ and export/.
NAS_ROOT=/mnt/nas/data/paperless

# Owner of files Paperless writes; match the CIFS mount's uid/gid (`id` on bps27).
PUID=1000
PGID=1000

# Generate each with: openssl rand -base64 48 | tr -d '/+=' | head -c 50
DB_PASSWORD=
SECRET_KEY=
